{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "plugin": ["typedoc-plugin-markdown"],
  "entryPoints": ["src/index.ts", "src/testing/index.ts"],
  "tsconfig": "tsconfig.json",
  "exclude": ["**/__tests__/**"],
  "out": "docs/api",
  "readme": "none",
  "cleanOutputDir": true,
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "disableSources": true,
  "outputFileStrategy": "members",
  "membersWithOwnFile": ["Class", "Interface"],
  "indexFormat": "table",
  "parametersFormat": "table",
  "useCodeBlocks": true,
  "hidePageHeader": true,
  "categoryOrder": [
    "Messaging",
    "Hook contexts",
    "Hooks",
    "Filesystem",
    "Plugin storage",
    "HTTP",
    "Browser",
    "Toast",
    "Events",
    "Binary execution",
    "Binary resolution",
    "Platform",
    "Cookies",
    "Environment",
    "Plugin manifest",
    "Messages",
    "Enhance",
    "Social",
    "*",
    "Tauri core (deprecated)"
  ]
}
