{
  "name": "@symbiosis-lab/moss-api",
  "version": "0.15.0",
  "description": "Official API for building moss plugins - types and utilities for plugin development",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./testing": {
      "import": "./dist/testing/index.mjs",
      "types": "./dist/testing/index.d.mts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs": "typedoc",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "moss",
    "plugin",
    "sdk",
    "api",
    "tauri",
    "publishing",
    "syndication"
  ],
  "author": "Guo Liu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Symbiosis-Lab/moss.git",
    "directory": "packages/moss-api"
  },
  "bugs": {
    "url": "https://github.com/Symbiosis-Lab/moss-api/issues"
  },
  "homepage": "https://github.com/Symbiosis-Lab/moss-api#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": false
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "tsdown": "^0.23.3",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
