{
  "name": "@symbiosis-lab/moss-syntax",
  "version": "0.1.0",
  "private": true,
  "description": "moss's markdown syntax layer — shortcode/wikilink/math grammars and pure line parsers, shared by the moss editor and the Obsidian plugin",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./cm6": {
      "import": "./dist/cm6/index.mjs",
      "types": "./dist/cm6/index.d.mts"
    },
    "./cm6/cm-shortcode-block.css": "./src/cm6/cm-shortcode-block.css"
  },
  "files": [
    "dist",
    "src/cm6/cm-shortcode-block.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "moss",
    "markdown",
    "shortcode",
    "wikilink",
    "lezer",
    "codemirror"
  ],
  "author": "Guo Liu",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@codemirror/language": "^6",
    "@codemirror/lint": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1",
    "@lezer/markdown": "^1"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "jsdom": "^30.1.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
