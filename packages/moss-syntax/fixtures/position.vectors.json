      "position": null,
      "note": "a bare percentage is not a position"
    },
    {
      "input": "middle",
      "position": null,
      "note": "not a position word"
    },
    {
      "input": "top-bottom",
      "position": null,
      "note": "not a position word"
    },
    {
      "input": "",
      "position": null,
      "note": "empty input"
    },
    {
      "input": "cover",
      "position": null,
      "note": "a fit word is not a position"
    },
    {
      "input": "align-left",
      "position": null,
      "note": "an align word is not a position"
    }
