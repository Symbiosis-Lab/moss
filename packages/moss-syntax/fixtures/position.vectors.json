{
  "_comment": [
    "Cross-language contract for the image-options words: where an image is",
    "cropped to (`position`), how it is fitted (`fit`), and which side it floats on (`align`).",
    "Rust side: crates/moss-core/tests/position_vectors.rs requires `Position::from_keyword`",
    "to give `position` for every `position_words` input, and `parse_media_attrs` to give",
    "`fit`/`position`/`align` for every `frame_segments` input.",
    "A position is a name, `{\"focus\": [x, y]}` (integers 0-100), or null for not-a-position.",
    "A mirror of this grammar elsewhere loads this file and requires the same answers.",
    "This file is the gate: when the grammar changes, add or change a vector."
  ],
  "position_words": [
    {
      "input": "center",
      "position": "center",
      "note": "`center` names center"
    },
    {
      "input": "left",
      "position": "left",
      "note": "`left` names left"
    },
    {
      "input": "right",
      "position": "right",
      "note": "`right` names right"
    },
    {
      "input": "top",
      "position": "top",
      "note": "`top` names top"
    },
    {
      "input": "bottom",
      "position": "bottom",
      "note": "`bottom` names bottom"
    },
    {
      "input": "top-left",
      "position": "top-left",
      "note": "`top-left` names top-left"
    },
    {
      "input": "topleft",
      "position": "top-left",
      "note": "`topleft` names top-left"
    },
    {
      "input": "top left",
      "position": "top-left",
      "note": "`top left` names top-left"
    },
    {
      "input": "top-right",
      "position": "top-right",
      "note": "`top-right` names top-right"
    },
    {
      "input": "topright",
      "position": "top-right",
      "note": "`topright` names top-right"
    },
    {
      "input": "top right",
      "position": "top-right",
      "note": "`top right` names top-right"
    },
    {
      "input": "bottom-left",
      "position": "bottom-left",
      "note": "`bottom-left` names bottom-left"
    },
    {
      "input": "bottomleft",
      "position": "bottom-left",
      "note": "`bottomleft` names bottom-left"
    },
    {
      "input": "bottom left",
      "position": "bottom-left",
      "note": "`bottom left` names bottom-left"
    },
    {
      "input": "bottom-right",
      "position": "bottom-right",
      "note": "`bottom-right` names bottom-right"
    },
    {
      "input": "bottomright",
      "position": "bottom-right",
      "note": "`bottomright` names bottom-right"
    },
    {
      "input": "bottom right",
      "position": "bottom-right",
      "note": "`bottom right` names bottom-right"
    },
    {
      "input": "TOP-LEFT",
      "position": "top-left",
      "note": "`TOP-LEFT`: keywords are case-insensitive"
    },
    {
      "input": "Bottom Right",
      "position": "bottom-right",
      "note": "`Bottom Right`: keywords are case-insensitive"
    },
    {
      "input": "CENTER",
      "position": "center",
      "note": "`CENTER`: keywords are case-insensitive"
    },
    {
      "input": "TopLeft",
      "position": "top-left",
      "note": "`TopLeft`: keywords are case-insensitive"
    },
    {
      "input": "focus:20%,62%",
      "position": {
        "focus": [
          20,
          62
        ]
      },
      "note": "a focus point"
    },
    {
      "input": "focus:0%,0%",
      "position": {
        "focus": [
          0,
          0
        ]
      },
      "note": "focus lower bound"
    },
    {
      "input": "focus:100%,100%",
      "position": {
        "focus": [
          100,
          100
        ]
      },
      "note": "focus upper bound"
    },
    {
      "input": "FOCUS:5%,95%",
      "position": {
        "focus": [
          5,
          95
        ]
      },
      "note": "focus prefix is case-insensitive"
    },
    {
      "input": "focus:007%,050%",
      "position": {
        "focus": [
          7,
          50
        ]
      },
      "note": "leading zeros still read as integers"
    },
    {
      "input": "focus:101%,0%",
      "position": null,
      "note": "x above 100"
    },
    {
      "input": "focus:0%,101%",
      "position": null,
      "note": "y above 100"
    },
    {
      "input": "focus:20%",
      "position": null,
      "note": "one coordinate is not a point"
    },
    {
      "input": "focus:a%,b%",
      "position": null,
