{
  "name": "@symbiosis-lab/obsidian-moss",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin that builds and previews the current vault as a moss website via the moss CLI",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && wdio run e2e/wdio.conf.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@symbiosis-lab/moss-syntax": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "esbuild": "^0.28.2",
    "expect-webdriverio": "^8.0.0",
    "mocha": "^12.0.3",
    "obsidian": "^1.14.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wdio-obsidian-reporter": "^3.4.0",
    "wdio-obsidian-service": "^3.4.0"
  }
}
