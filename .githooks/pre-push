#!/bin/sh
# Runs the size ratchet before anything leaves this machine. Nothing else —
# it's the one check cheap enough to run on every push (a few hundred files,
# a few seconds) rather than only in CI on a pull request, which is how the
# baseline drifted before this hook existed.
#
# node is assumed present for anyone developing this repo, but these hooks
# also install for a plain `pnpm install` in contexts that don't have it
# wired the same way — never block a push over a missing interpreter.
if ! command -v node >/dev/null 2>&1; then
  exit 0
fi

exec node scripts/ratchet.mjs check
