+        // MOSS PATCH (idiomorph#TBD): recreate the node in its OWN namespace via
+        // createElementNS, keyed on localName (NOT tagName). Plain createElement
+        // makes an HTML-namespaced element, so a recreated <svg> becomes an
+        // HTMLUnknownElement and setAttribute lowercases case-sensitive SVG names
+        // (viewBox→viewbox) → the graphic renders invisible. But tagName is
+        // UPPERCASE for HTML elements and createElementNS does NOT case-normalize,
+        // so tagName would yield uppercase-localName HTML nodes (<NAV>, <ARTICLE>)
+        // that miss lowercase type-selector CSS → layout collapses. localName is
+        // correct in every namespace: "nav" for HTML, "clipPath" for SVG.
+        const newEmptyChild = document.createElementNS(
+          /** @type {Element} */ (newChild).namespaceURI,
+          /** @type {Element} */ (newChild).localName,
         );
         oldParent.insertBefore(newEmptyChild, insertionPoint);
         morphNode(newEmptyChild, newChild, ctx);
